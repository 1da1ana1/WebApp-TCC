# Variáveis do docker-compose.yml (ambiente completo).
# Copie para .env e ajuste — NÃO versione o .env real.

# Banco de dados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=webapp_db

# API
# IMPORTANTE: troque por um segredo forte e único em produção.
JWT_SECRET=troque-este-segredo-em-producao

# Portas publicadas no host
API_PORT=3000
WEB_PORT=8080
