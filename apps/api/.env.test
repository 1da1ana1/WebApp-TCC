# Variáveis de ambiente da suíte de testes (e2e/CI).
# Aponta para o Postgres efêmero do docker-compose.test.yml (porta 5433).
# Pode ser versionado: as credenciais aqui são descartáveis e locais.

DATABASE_URL="postgresql://test:test@localhost:5433/webapp_test?schema=public"
JWT_SECRET="test-secret-key"
PORT=3001
